# 复制为 .env 后修改。
# 所有配置项都可以通过环境变量覆盖，字段名大小写不敏感。

# ---------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/库存管理系统?charset=utf8mb4

# 是否打印 SQLAlchemy 生成的 SQL，开发排查时可设为 true
DB_ECHO=false

# 真实 MySQL 并发测试使用的独立测试库（脚本/用例会创建缺失的表）
MYSQL_TEST_URL=mysql+pymysql://root:你的密码@localhost:3306/库存管理系统_test?charset=utf8mb4

# ---------------------------------------------------------------------
# 登录与权限（JWT）
# ---------------------------------------------------------------------
# 生产环境必须换成随机长字符串，否则 token 可以被伪造
SECRET_KEY=请替换为至少32位的随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 启动时用户表为空则自动创建管理员
BOOTSTRAP_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------
# Redis 缓存
# ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# 缓存默认关闭；需要时改为 true（Redis 不可用会自动降级为内存缓存）
CACHE_ENABLED=false
CACHE_TTL_SECONDS=30

# ---------------------------------------------------------------------
# 接口限流
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# 每个窗口的默认额度（未单独指定 limit 的接口使用）
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_WINDOW_SECONDS=60
